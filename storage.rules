rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    /* Plush görselleri: herkese okunabilir (K6 — getDownloadURL ile üretilen
       <img src> istekleri Firebase Auth token'ı taşımadığından request.auth != null
       okumayı kırıyordu). Yazma: giriş + tip + boyut sınırı.
       Delete (G6): RTDB üyelik kontrolü Storage kurallarından yapılamadığı için
       request.auth != null olarak korunur; dosya yolunu bilen giriş yapmış kullanıcı
       silebilir — bu bilinçli bir karardır, ROADMAP G6'ya bakın. */
    match /plush_images/{imageId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    /* Profil fotoğrafları: aynı kısıtlar (K6 — read herkese açık). */
    match /avatars/{imageId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    /* Chat medyası: oda ve DM görselleri + videoları.
       Maks 25MB; görsel (image/*) ve video (video/mp4, video/quicktime).
       K6 — read herkese açık (<img src>/<video src> auth token'ı taşımaz). */
    match /chat_media/{mediaId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 25 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('video/.*'));
      allow delete: if request.auth != null;
    }
  }
}
